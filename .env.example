# Copy this file to .env and fill in real values. .env is gitignored.

# Rebrickable API (bonus objective — get_set_match)
# Get a free key at https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# Paths (override if your data/model locations differ from the defaults in app/params.py)
DATA_DIR=data
MODELS_DIR=models

# Classification (Objective 1)
# Which architecture to train: app/classification/models/model_<MODEL_NAME>.py
# Leave unset to use christophe. Override per run instead if you only want it
# once:  make run_local MODEL_NAME=oriane
MODEL_NAME=christophe
NUM_CLASSES=50
CLASSIFICATION_DATA_DIR=data/lego-dataset-classification

# Detection (Objective 2)
DETECTION_DATA_DIR=data/lego-tagged-object_detection
