# Copy this file to .env and fill in real values. .env is gitignored.

BUCKET_NAME=legofitter-datasets
GCP_PROJECT=legofitter-app

# Rebrickable API (bonus objective — get_set_match)
# Get a free key at https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# Paths (override if your data/model locations differ from the defaults in app/params.py)
DATA_DIR=data
MODELS_DIR=models

# Classification (Objective 1)
# Which architecture to train: app/classification/models/model_<MODEL_NAME>.py
# Leave unset to use christophe. Override per run instead if you only want it
# once:  make run_local MODEL_NAME=oriane
MODEL_NAME=christophe
# float16 compute on a GPU with tensor cores (the VM's T4). `make run_vm` sets
# this for you, so you only need it here for a non-Makefile run on a GPU box.
# Leave it off/absent on a laptop -- no tensor cores, no benefit.
USE_MIXED_PRECISION=false
NUM_CLASSES=50
CLASSIFICATION_DATA_DIR=data/lego-dataset-classification

# Detection (Objective 2)
DETECTION_DATA_DIR=data/lego-tagged-object_detection

# Detection (Objective 2)
# Machine-wide defaults for YOLO. Usually left unset -- override per run
# instead:  make train_detection_vm YOLO_BASE_MODEL=yolo26s.pt YOLO_EPOCHS=100
# YOLO_BASE_MODEL=yolo26n.pt
# YOLO_EPOCHS=50
# YOLO_BATCH_SIZE=8
